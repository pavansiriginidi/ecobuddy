# Backend environment variables. Copy this file to api/.env and fill in your secrets locally.

# Groq API key for AI recommendations.
# Put your server-side Groq key here.
GROQ_API_KEY=your_groq_api_key_here

# MongoDB URI for backend persistence.
# Put your MongoDB Atlas connection string here.
MONGO_URI=your_mongodb_uri_here

# Database name used by the API.
MONGO_DB_NAME=ecobuddy

# JWT secret for authenticated routes if you add login/session protection.
# Put your backend signing secret here.
JWT_SECRET=your_jwt_secret_here

# Optional backend settings.
FRONTEND_URL=http://localhost:5173
PORT=3001
