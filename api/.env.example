# Backend Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key for AI Recommendations
# Get this from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Connection URI
# Local: mongodb://localhost:27017/ecobuddy
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/ecobuddy
MONGO_URI=mongodb://localhost:27017/ecobuddy

# Server Port
PORT=3001

# Environment
NODE_ENV=development
