# Frontend (Vite) - client-side vars must start with VITE_
VITE_API_BASE_URL=https://api.example.com

# Backend (if you deploy the API separately)
# Example values you should set in your API host (Railway/Render/etc.) or locally in api/.env
MONGO_URI=
GROQ_API_KEY=
FRONTEND_URL=https://your-vercel-domain.vercel.app
# Copy this file to .env (for local dev) or add these variables in Vercel Project Settings

# Client (Vite) envs (prefix with VITE_)
VITE_API_BASE_URL=/api
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# Server envs
MONGO_URI=mongodb://username:password@host:port/ecobuddy
GROQ_API_KEY=your_groq_api_key_here

# Optional: set PORT for local API dev
PORT=3001
