# Copy this file to .env (for local dev) or add these variables in Vercel Project Settings

# Client (Vite) envs (prefix with VITE_)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=/api
VITE_PEXELS_API_KEY=your_pexels_api_key_here

# Server envs
MONGO_URI=mongodb://username:password@host:port/ecobuddy
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: set PORT for local API dev
PORT=3001
